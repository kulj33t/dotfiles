{
    "layer": "top",
    "position": "top",
    "margin-top": 10,
    "margin-left": 10,
    "margin-right": 10,
    "height": 40,

    "modules-left": [
        "custom/launcher",
        "clock",
        "cpu",
        "memory",
        "memory#swap",
        "disk"
    ],
    "modules-center": [
        "hyprland/workspaces"
    ],
    "modules-right": [
        "custom/clipboard",
        "custom/notifications",
        "custom/kbd_backlight",
        "pulseaudio#microphone",
        "pulseaudio",
        "backlight",
        "battery",
        "bluetooth",
        "network",
        "custom/updates",
        "tray",
        "custom/lock"
    ],

    // --- Module Configuration ---

    "custom/launcher": {
        "format": "",
        "on-click": "pkill wofi || wofi --show drun",
        "tooltip": false
    },

    "cpu": {
        "interval": 2,
        "format": " {usage}%",
        "tooltip": true
    },

    "memory": {
        "interval": 2,
        "format": " {percentage}%",
        "tooltip": true,
        "tooltip-format": "RAM: {used:0.1f}GiB / {total:0.1f}GiB ({percentage}%)"
    },

    "memory#swap": {
        "interval": 2,
        "format": " {swapPercentage}%",
        "tooltip": true,
        "tooltip-format": "Swap: {swapUsed:0.1f}GiB / {swapTotal:0.1f}GiB"
    },

    "disk": {
        "interval": 30,
        "format": " {percentage_used}%",
        "path": "/",
        "tooltip": true
    },

    "hyprland/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "format": "{icon}",
        "format-icons": {
            "default": "",
            "active": "",
            "urgent": ""
        }
    },

    "clock": {
        "format": " {:%I:%M %p}",
        "format-alt": " {:%A, %B %d, %Y}",
        "tooltip": false
    },

    "custom/clipboard": {
        "format": "",
        "on-click": "bash -c 'exec \"${XDG_CONFIG_HOME:-$HOME/.config}/scripts/wofi-clipboard.sh\"'",
        "tooltip": false
    },

    "custom/notifications": {
        "format": "󰂚",
        "on-click": "swaync-client -t -s",
        "tooltip": false
    },

    "custom/kbd_backlight": {
        "exec": "bash -c 'exec \"${XDG_CONFIG_HOME:-$HOME/.config}/waybar/scripts/kbdbacklight.sh\"'",
        "return-type": "json",
        "on-click": "bash -c 'exec \"${XDG_CONFIG_HOME:-$HOME/.config}/waybar/scripts/kbdbacklight.sh\" toggle'",
        "interval": 3,
        "tooltip": true
    },

    "backlight": {
        "device": "",
        "format": "{percent}% ",
        "tooltip": false
    },

    "pulseaudio": {
        "format": "{volume}% ",
        "format-muted": "<span color='#565f89'>Muted </span>",
        "on-click": "pavucontrol",
        "tooltip": false
    },

    "pulseaudio#microphone": {
        "format": "{format_source}",
        "format-source": "<span color='#f7768e'></span>",
        "format-source-muted": "<span color='#565f89'></span>",
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
        "tooltip": false
    },

    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{capacity}% {icon}",
        "format-charging": "{capacity}% ",
        "format-plugged": "{capacity}% ",
        "format-icons": ["", "", "", "", ""],
        "tooltip": true
    },

    "bluetooth": {
        "format": "",
        "format-connected": "{device_alias} ",
        "format-disabled": "",
        "max-length": 15,
        "on-click": "blueman-manager",
        "tooltip-format": "{controller_alias}\t{controller_address}",
        "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}"
    },

    "network": {
        "format-wifi": "{essid} ",
        "format-ethernet": "Wired ",
        "format-disconnected": "",
        "format-disabled": "",
        "max-length": 20,
        "on-click": "bash -c 'exec \"${XDG_CONFIG_HOME:-$HOME/.config}/scripts/network-menu.sh\"'",
        "tooltip-format": "{essid} ({signalStrength}%)"
    },

    "custom/updates": {
        "format": " {}",
        "exec": "bash -c 'exec \"${XDG_CONFIG_HOME:-$HOME/.config}/waybar/scripts/updates.sh\"'",
        "return-type": "json",
        "on-click": "bash -c '\"${XDG_CONFIG_HOME:-$HOME/.config}/waybar/scripts/updates.sh\" check'",
        "signal": 8,
        "tooltip": true
    },

    "custom/lock": {
        "format": "",
        "on-click": "bash -c 'exec \"${XDG_CONFIG_HOME:-$HOME/.config}/scripts/wofi-power.sh\"'",
        "tooltip": false
    }
}
